# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Твой Telegram Chat ID (для уведомлений)
MY_CHAT_ID=123456789

# OpenAI API Key (получить на platform.openai.com)
OPENAI_API_KEY=sk-...

# Путь для сохранения голосовых файлов
VIDEO_SAVING_PATH=/opt/ielts-bot/savings

# ID группы, которую обслуживает бот (число со знаком минус, например -1001234567890)
# Узнать ID: добавь @username_to_id_bot в группу или перешли сообщение из группы на @userinfobot
GROUP_ID=-1001234567890
