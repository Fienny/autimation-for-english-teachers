# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# OpenAI API Key (получить на platform.openai.com)
OPENAI_API_KEY=sk-...

# Путь для сохранения голосовых файлов
VIDEO_SAVING_PATH=/opt/ielts-bot/savings

# ID одной группы, которую обслуживает бот (оставлено для совместимости)
# Узнать ID: добавь @userinfobot в группу, напиши /start, скопируй ID, удали бота
GROUP_ID=-1001234567890

# ID нескольких разрешённых групп через запятую.
# Если заполнены GROUP_ID и GROUP_IDS, бот разрешит доступ по всем указанным группам.
GROUP_IDS=-1001234567890,-1002345678901,-1003456789012
